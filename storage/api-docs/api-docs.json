        "/api/kosts": {
            "post": {
                "tags": [
                    "Kosts"
                ],
                "summary": "Create a new kost",
                "operationId": "83eee01ee48017dfb624675d1943289d",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "description",
                                    "address",
                                    "price",
                                    "room_available"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Kost Melati"
                                    },
                                    "description": {
                                        "type": "string",
                                        "example": "Comfortable kost near campus"
                                    },
                                    "address": {
                                        "type": "string",
                                        "example": "Jl. Merdeka No. 10"
                                    },
                                    "price": {
                                        "type": "number",
                                        "format": "float",
                                        "example": 1500000
                                    },
                                    "room_available": {
                                        "type": "integer",
                                        "example": 5
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Kost created successfully"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/kosts/{id}": {
