                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Kost fetched successfully"
                    },
                    "404": {
                        "description": "Kost not found"
                    }
                }
            },
            "put": {
                "tags": [
                    "Kosts"
                ],
                "summary": "Update an existing kost",
                "operationId": "4dd8110372935a77baca15d97a5ba5c0",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Kost ID",
                        "required": true,
